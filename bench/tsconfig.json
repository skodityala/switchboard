{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "paths": {
      "@switchboard/catalog": [
        "../packages/catalog/src/index.ts"
      ],
      "@switchboard/memory": [
        "../packages/memory/src/index.ts"
      ],
      "@switchboard/reasoner": [
        "../packages/reasoner/src/index.ts"
      ],
      "@switchboard/channel": [
        "../packages/channel/src/index.ts"
      ]
    }
  },
  "include": [
    "bench.ts"
  ],
  "references": [
    {
      "path": "../packages/catalog"
    },
    {
      "path": "../packages/reasoner"
    },
    {
      "path": "../packages/memory"
    }
  ]
}
