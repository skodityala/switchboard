{
  "name": "switchboard",
  "private": true,
  "version": "0.1.0",
  "description": "An AI phone agent for independent clinics that structurally cannot leak patient data. Data access is gated at runtime by a metadata catalog, not by a prompt.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsc --build && node bench/dist/bench.js",
    "bench:mem": "tsc --build && node --expose-gc bench/dist/bench.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
